# Copy this file to .env for local development.
# The defaults also work without a .env file; change the JWT key before deployment.
TRAINING_ENVIRONMENT=development
TRAINING_DATABASE_URL=sqlite:///./data/trainingsplan.db
TRAINING_JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
TRAINING_ACCESS_TOKEN_EXPIRE_MINUTES=720
TRAINING_GOOGLE_CLIENT_ID=448679981151-siu7ifltrqhle8koamlb70tnkjuqcg7m.apps.googleusercontent.com
TRAINING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TRAINING_EXERCISE_DATABASE_PATH=app/data/fitness_exercise_database_de.json

# Paywall: free accounts see the first N weeks of every plan; Plus or a one-time purchase unlocks the rest.
TRAINING_PAYWALL_ENABLED=true
TRAINING_PREVIEW_WEEKS=2
# Stripe (https://dashboard.stripe.com/apikeys, Developers > Webhooks). Prices are found by lookup key:
# trainingsprofil_plus_monthly, trainingsprofil_plus_yearly, trainingsprofil_single_block.
# Leave the secret key empty locally: the preview paywall still applies, checkout returns 503 and the
# pricing sheet values are shown as fallback.
TRAINING_STRIPE_SECRET_KEY=
TRAINING_STRIPE_WEBHOOK_SECRET=
# Public frontend URL for Stripe redirects; defaults to the first CORS origin.
# TRAINING_FRONTEND_URL=http://localhost:5173
