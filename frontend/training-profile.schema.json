{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/training-profile-v1.json",
  "title": "TrainingProfile v1.0",
  "description": "Strukturierte Angaben aus dem kundenorientierten Trainings-Check zur späteren Trainingsplan-Erstellung.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "identity",
    "goals",
    "experience",
    "schedule",
    "environment",
    "health",
    "preferences",
    "recovery",
    "consent"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstName",
        "ageGroup",
        "gender",
        "heightCm",
        "weightKg"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "maxLength": 100
        },
        "ageGroup": {
          "type": "string",
          "enum": [
            "",
            "Unter 18",
            "18–29",
            "30–39",
            "40–49",
            "50–59",
            "60–69",
            "70+"
          ]
        },
        "gender": {
          "type": "string",
          "enum": [
            "",
            "Weiblich",
            "Männlich",
            "Divers",
            "Keine Angabe"
          ]
        },
        "heightCm": {
          "type": "string",
          "pattern": "^$|^[0-9]{2,3}$"
        },
        "weightKg": {
          "type": "string",
          "pattern": "^$|^[0-9]{1,3}([.,][0-9]{1,2})?$"
        }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryGoal",
        "secondaryGoals",
        "sports",
        "motivation",
        "event"
      ],
      "properties": {
        "primaryGoal": {
          "type": "string",
          "enum": [
            "",
            "healthy_strength",
            "strength_muscle",
            "endurance",
            "event",
            "mobility",
            "return",
            "weight"
          ]
        },
        "secondaryGoals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "healthy_strength",
              "strength_muscle",
              "endurance",
              "event",
              "mobility",
              "return",
              "weight"
            ]
          }
        },
        "sports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "strength",
              "running",
              "trail",
              "cycling",
              "swimming",
              "triathlon",
              "hiking",
              "mobility",
              "other"
            ]
          }
        },
        "motivation": {
          "type": "string",
          "maxLength": 2000
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "type",
            "name",
            "date",
            "distance",
            "targetTime"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "",
                "running",
                "trail",
                "triathlon",
                "cycling",
                "hiking",
                "strength",
                "other"
              ]
            },
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "date": {
              "type": "string",
              "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "distance": {
              "type": "string",
              "maxLength": 100
            },
            "targetTime": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "currentTrainingDays",
        "trainingHistoryYears",
        "recentBreak",
        "currentActivities",
        "weeklyRunningKm",
        "longestRunKm",
        "cyclingHours",
        "swimmingMeters",
        "currentRoutine"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "",
            "new",
            "returning",
            "regular",
            "experienced"
          ]
        },
        "currentTrainingDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "trainingHistoryYears": {
          "type": "string",
          "enum": [
            "",
            "none",
            "under_1",
            "1_3",
            "3_5",
            "5_plus"
          ]
        },
        "recentBreak": {
          "type": "string",
          "enum": [
            "",
            "no",
            "under_1m",
            "1_3m",
            "3_6m",
            "6m_plus"
          ]
        },
        "currentActivities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "strength",
              "running",
              "trail",
              "cycling",
              "swimming",
              "triathlon",
              "hiking",
              "mobility",
              "other"
            ]
          }
        },
        "weeklyRunningKm": {
          "$ref": "#/$defs/numericString"
        },
        "longestRunKm": {
          "$ref": "#/$defs/numericString"
        },
        "cyclingHours": {
          "$ref": "#/$defs/numericString"
        },
        "swimmingMeters": {
          "$ref": "#/$defs/numericString"
        },
        "currentRoutine": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desiredSessions",
        "availableDays",
        "sessionDuration",
        "preferredTimes",
        "planStartDate",
        "scheduleNotes"
      ],
      "properties": {
        "desiredSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "availableDays": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "sessionDuration": {
          "type": "integer",
          "enum": [
            20,
            30,
            45,
            60,
            75,
            90
          ]
        },
        "preferredTimes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "morning",
              "midday",
              "evening",
              "flexible"
            ]
          }
        },
        "planStartDate": {
          "type": "string",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scheduleNotes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locations",
        "equipmentIds",
        "equipmentNotes"
      ],
      "properties": {
        "locations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "home",
              "gym",
              "outdoor",
              "pool"
            ]
          }
        },
        "equipmentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "BODY",
              "FLOOR",
              "MAT",
              "WALL",
              "CHAIR",
              "BENCH",
              "ADJ_BENCH",
              "BOX",
              "STEP",
              "SLIDERS",
              "SLANT_BOARD",
              "DUMBBELL",
              "BARBELL",
              "PLATES",
              "RACK",
              "EZ_BAR",
              "TRAP_BAR",
              "SSB",
              "SWISS_BAR",
              "KETTLEBELL",
              "WEIGHT_VEST",
              "ANKLE_WEIGHTS",
              "PULLUP_BAR",
              "DIP_BARS",
              "PARALLETTES",
              "RINGS",
              "TRX",
              "BAND",
              "MINIBAND",
              "TUBE_BAND",
              "CABLE",
              "DUAL_CABLE",
              "LAT_PULLDOWN",
              "LOW_ROW",
              "LANDMINE",
              "SMITH",
              "LEG_PRESS",
              "HACK_SQUAT",
              "BELT_SQUAT",
              "LEG_EXTENSION",
              "LEG_CURL",
              "HIP_THRUST_MACHINE",
              "CALF_MACHINE",
              "HIP_ABD_MACHINE",
              "HIP_ADD_MACHINE",
              "CHEST_PRESS_MACHINE",
              "SHOULDER_PRESS_MACHINE",
              "PEC_DECK",
              "REVERSE_FLY_MACHINE",
              "ROW_MACHINE",
              "PULLDOWN_MACHINE",
              "ASSISTED_PULLUP",
              "BICEPS_MACHINE",
              "TRICEPS_MACHINE",
              "AB_MACHINE",
              "BACK_EXTENSION_MACHINE",
              "PREACHER_BENCH",
              "GHD",
              "BACK_EXTENSION_BENCH",
              "REVERSE_HYPER",
              "AB_WHEEL",
              "SWISS_BALL",
              "BOSU",
              "FOAM_ROLLER",
              "MED_BALL",
              "SLAM_BALL",
              "SANDBAG",
              "SLED",
              "FARMER_HANDLES",
              "YOKE",
              "TIRE",
              "SLEDGEHAMMER",
              "BATTLE_ROPE",
              "ROPE",
              "MACE",
              "GRIPPER",
              "WRIST_ROLLER",
              "NECK_HARNESS",
              "JUMP_ROPE",
              "TREADMILL",
              "BIKE",
              "AIR_BIKE",
              "ROWER",
              "SKI_ERG",
              "ELLIPTICAL",
              "STAIR_CLIMBER",
              "POOL",
              "OUTDOOR",
              "SISSY_SQUAT",
              "TOWEL",
              "PINCH_BLOCK",
              "FAT_GRIP"
            ]
          }
        },
        "equipmentNotes": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "painFree",
        "restrictions",
        "safetyFlags",
        "safetyConfirmedNone",
        "conditions",
        "medicationsNotes",
        "healthNotes"
      ],
      "properties": {
        "painFree": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bodyRestriction"
          }
        },
        "safetyFlags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safetyFlag"
          }
        },
        "safetyConfirmedNone": {
          "type": "boolean"
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Arthrose / Gelenkbeschwerden",
              "Osteoporose / geringe Knochendichte",
              "Diabetes / Stoffwechselerkrankung",
              "Asthma / Atemwegserkrankung",
              "Herz-Kreislauf-Erkrankung",
              "Neurologische Erkrankung",
              "Keine bekannte Erkrankung"
            ]
          }
        },
        "medicationsNotes": {
          "type": "string",
          "maxLength": 3000
        },
        "healthNotes": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "likedStyles",
        "dislikedStyles",
        "coachingTone",
        "variety",
        "indoorOutdoor",
        "excludedExercises",
        "adherenceBarrier"
      ],
      "properties": {
        "likedStyles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trainingStyle"
          }
        },
        "dislikedStyles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trainingStyle"
          }
        },
        "coachingTone": {
          "type": "string",
          "enum": [
            "supportive",
            "balanced",
            "direct",
            "technical"
          ]
        },
        "variety": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "indoorOutdoor": {
          "type": "string",
          "enum": [
            "indoor",
            "balanced",
            "outdoor"
          ]
        },
        "excludedExercises": {
          "type": "string",
          "maxLength": 3000
        },
        "adherenceBarrier": {
          "type": "string",
          "enum": [
            "",
            "Zeitmangel",
            "Unregelmässiger Alltag",
            "Motivationsschwankungen",
            "Schmerzen oder Unsicherheit",
            "Zu anspruchsvolle Pläne",
            "Lange Anfahrt zum Training",
            "Keine besondere Hürde"
          ]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sleepHours",
        "sleepQuality",
        "stressLevel",
        "recoveryFeeling",
        "sedentaryHours"
      ],
      "properties": {
        "sleepHours": {
          "type": "number",
          "minimum": 4,
          "maximum": 10,
          "multipleOf": 0.5
        },
        "sleepQuality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "stressLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "recoveryFeeling": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "sedentaryHours": {
          "type": "string",
          "enum": [
            "",
            "under_4",
            "4_6",
            "6_8",
            "8_10",
            "10_plus"
          ]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataProcessing",
        "healthAcknowledgement",
        "optionalContact"
      ],
      "properties": {
        "dataProcessing": {
          "type": "boolean"
        },
        "healthAcknowledgement": {
          "type": "boolean"
        },
        "optionalContact": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "numericString": {
      "type": "string",
      "pattern": "^$|^[0-9]+([.,][0-9]+)?$"
    },
    "trainingStyle": {
      "type": "string",
      "enum": [
        "free_weights",
        "machines",
        "bodyweight",
        "steady_cardio",
        "intervals",
        "circuits",
        "mobility",
        "outdoor"
      ]
    },
    "bodyRestriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "region",
        "side",
        "intensity",
        "symptoms",
        "duration",
        "triggers",
        "strategy",
        "professionalClearance",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "enum": [
            "neck",
            "shoulder",
            "upper_arm",
            "forearm_wrist",
            "chest",
            "upper_back",
            "lower_back",
            "hip_groin",
            "thigh",
            "knee",
            "lower_leg",
            "ankle_foot"
          ]
        },
        "side": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "both",
            "not_applicable"
          ]
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "symptoms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "pain",
              "stiffness",
              "instability",
              "weakness",
              "numbness"
            ]
          }
        },
        "duration": {
          "type": "string",
          "enum": [
            "",
            "days",
            "weeks",
            "months",
            "chronic"
          ]
        },
        "triggers": {
          "type": "string",
          "maxLength": 3000
        },
        "strategy": {
          "type": "string",
          "enum": [
            "avoid",
            "adapt",
            "monitor"
          ]
        },
        "professionalClearance": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "not_needed"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "safetyFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "chest_symptoms",
            "dizziness",
            "cardio_condition",
            "recent_surgery",
            "pregnancy",
            "neurological"
          ]
        },
        "value": {
          "type": "boolean"
        }
      }
    }
  }
}
